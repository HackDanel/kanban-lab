# Скопируйте в .env и поменяйте секреты. Файл .env в репозиторий не попадает.

APP_ENV=development
HTTP_ADDR=:8080
PUBLIC_URL=http://localhost:8080

# PostgreSQL
POSTGRES_USER=kanban
POSTGRES_PASSWORD=kanban
POSTGRES_DB=kanban
DATABASE_URL=postgres://kanban:kanban@localhost:5432/kanban?sslmode=disable
DB_MAX_CONNS=50

# Redis
REDIS_URL=redis://localhost:6379/0

# Аутентификация
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
JWT_ACCESS_TTL=15m
REFRESH_TTL=720h
BCRYPT_COST=12
COOKIE_SECURE=false

# CORS: список origin через запятую
CORS_ORIGINS=http://localhost:5173

# Rate limit для /auth/*: запросов в минуту с одного IP
AUTH_RATE_LIMIT=20

# Вложения
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=10485760

# Первый администратор, создаётся при старте, если пользователей ещё нет
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
