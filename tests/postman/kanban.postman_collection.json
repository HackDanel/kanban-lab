{
  "info": {
    "name": "Kanban Lab API",
    "description": "Сценарные API-тесты. Запуск: newman run kanban.postman_collection.json -e local.postman_environment.json",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Readiness",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/readyz",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "readyz"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('dependencies up', () => pm.expect(pm.response.json()).to.eql({postgres: 'up', redis: 'up'}));"
            ]
          }
        }
      ]
    },
    {
      "name": "TC-01 Register developer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{devEmail}}\",\n  \"name\": \"Newman Dev\",\n  \"password\": \"password123\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('devEmail', `dev-${Date.now()}@example.com`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "const u = pm.response.json();",
              "pm.test('developer role', () => pm.expect(u.role).to.eql('developer'));",
              "pm.test('no password in response', () => pm.expect(u).to.not.have.property('passwordHash'));",
              "pm.collectionVariables.set('devId', u.id);"
            ]
          }
        }
      ]
    },
