        "body": {
          "mode": "raw",
          "raw": "{\n  \"key\": \"{{projectKey}}\",\n  \"name\": \"Newman project\",\n  \"description\": \"API tests\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';",
              "let key = 'N'; for (let i = 0; i < 7; i++) key += letters[Math.floor(Math.random() * 26)];",
              "pm.collectionVariables.set('projectKey', key);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "pm.test('response under 200 ms', () => pm.expect(pm.response.responseTime).to.be.below(200));",
              "pm.collectionVariables.set('projectId', pm.response.json().id);"
            ]
          }
        }
      ]
